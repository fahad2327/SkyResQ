# Virtual Environments
.venv/
.venv*/
venv/
env/
ENV/
backend/.venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# Large Model Weights & Training Checkpoints (Except small yolov8n.pt 6.5MB in ai/models for cloud deploy)
*.pt
!ai/models/yolov8n.pt
*.pth
*.onnx
*.weights
*.bin
runs/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Database & Storage
*.sqlite3
*.db
backend/*.sqlite3

# Logs & Temporary Files
*.log
logs/
scratch/

# Runtime Media & Uploaded Test Images
media/uploads/*
media/detections/*
!media/uploads/.gitkeep
!media/detections/.gitkeep
backend/data/*
!backend/data/.gitkeep

# OS Specific
.DS_Store
Thumbs.db
desktop.ini
